{
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "name": "ciart-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
