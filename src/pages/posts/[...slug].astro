---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import { getPostDateText } from '../../helpers/date';

interface Props {
  post: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts
    .map((post) => {
      return {
        params: { slug: post.id },
        props: { post },
      };
    })
    .filter((post) => post.props.post.data.published);
}

const { post } = Astro.props;
const { Content } = await render(post);

const tags = post.data.tags ?? [];
---

<BaseLayout title={post.data.title}>
  <div class="pb-20">
    <div class="mb-6 flex flex-col items-center">
      <div class="flex gap-1 font-pixel text-xs">
        {
          tags.map((tag) => (
            <a href={`/tags/${tag}`} class="text-blue-400">{`#${tag}`}</a>
          ))
        }
      </div>
      <h1 class="mb-2 font-serif text-3xl font-bold tracking-tight">
        {post.data.title}
      </h1>
      <p class="font-pixel text-xs">{getPostDateText(post)}</p>
    </div>
    <Prose>
      <Content />
    </Prose>
  </div>
</BaseLayout>
